{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Content": {
    "Path": "Data/portfolio.json"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Contact": {
    "StoreSubmissions": true,
    "StorePath": "App_Data/contact-messages.jsonl",
    "PermitLimitPerMinute": 5
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "ToAddress": ""
  }
}
