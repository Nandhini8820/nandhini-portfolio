# Backend configuration template. ASP.NET Core reads environment variables using
# double underscores for nesting (Section__Key). Never commit real values.
# For local development prefer: dotnet user-secrets set "Smtp:Password" "<value>"

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080

# Comma-free list: add one variable per allowed origin
Cors__AllowedOrigins__0=http://localhost:5173
# Cors__AllowedOrigins__1=https://your-portfolio-domain.example

# Store contact submissions as JSON lines on disk (useful locally; use durable storage in production)
Contact__StoreSubmissions=true
Contact__StorePath=App_Data/contact-messages.jsonl
Contact__PermitLimitPerMinute=5

# Optional email delivery. Leave Smtp__Host empty to disable email.
Smtp__Host=
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__Username=
Smtp__Password=
Smtp__FromAddress=
Smtp__ToAddress=
