# Copy to .env.local and adjust. Every VITE_ variable is bundled into public JavaScript,
# so never put secrets here.

# Base URL of the ASP.NET Core API as the browser should call it.
# Leave empty to call /api on the same origin (Vite dev proxy locally, or the API serving the built site).
# Set it when the frontend and API are hosted on different domains, e.g. https://api.your-domain.example
VITE_API_BASE_URL=

# Where the Vite dev server forwards /api requests during `npm run dev` and `npm run preview`.
VITE_API_PROXY_TARGET=http://localhost:5080

# Milliseconds before an API request is abandoned.
VITE_API_TIMEOUT_MS=10000
